{
  "manifest_version": 3,
  "name": "ClipMaster",
  "version": "8.5.0",
  "description": "A beautifully remastered, floating clipboard manager with syntax highlighting, code beautification, and offline image storage.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardRead",
    "notifications",
    "offscreen",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/c16.png",
      "48": "icons/c48.png",
      "128": "icons/c128.png"
    },
    "default_title": "Open ClipMaster (Alt+C)"
  },
  "commands": {
    "toggle-floater": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Toggle ClipMaster floating window"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/c16.png",
    "48": "icons/c48.png",
    "128": "icons/c128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "floating_ui.css",
        "floating_ui.js",
        "view.html",
        "view.js",
        "view.css",
        "highlighter.js",
        "beautifier.js",
        "icons/*.png",
        "icons/*.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
